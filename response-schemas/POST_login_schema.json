{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "title": "POST Login Response",
    "type": "object",
    "properties": {
        "access_token": {
            "type": "string",
            "minLength": 1
        },
        "token_type": {
            "type": "string",
            "minLength": 1
        },
        "expires_in": {
            "type": "number"
        }
    },
    "required": [
        "access_token",
        "token_type",
        "expires_in"
    ]
}
